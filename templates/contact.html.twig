{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'contact.title'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash--{{ type }}" role="status">{{ message|trans }}</p>
        {% endfor %}
    {% endfor %}

    <p>{{ 'contact.intro'|trans }}</p>

    {{ form_start(form, {attr: {class: 'contact-form', novalidate: 'novalidate'}}) }}
        {{ form_widget(form) }}
        <button type="submit">{{ 'form.send'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
