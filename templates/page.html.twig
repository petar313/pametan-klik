{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block meta %}
    {% if page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
    <link rel="canonical" href="{{ alternates[hreflang()] }}">
{% endblock %}

{% block body %}
    {% if audience is null %}
        {{ include('_home_gallery.html.twig') }}
    {% endif %}

    <article class="page page--{{ audience ?? 'home' }}">
        <h1>{{ page.title }}</h1>
        {{ page.html|raw }}
    </article>

    {% if menu %}
        <nav class="section-menu">
            <ul>
                {% for item in menu %}
                    <li><a href="{{ path('page', {section: item.section, slug: item.slug}) }}" {% if item.slug == page.slug %}aria-current="page"{% endif %}>{{ item.title }}</a></li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
